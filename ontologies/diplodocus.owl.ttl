@prefix : <http://labsoc.telecom-paris.fr/diplodocus#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://labsoc.telecom-paris.fr/diplodocus> rdf:type owl:Ontology ;
    rdfs:comment "Minimal Diplodocus ontology: covers the DataSize and CycleTime concepts of a network transfer, extended with channel semantics (blocking, loss), channel-to-architecture mapping and the network topology. Instantiated for the WACS/WADC running case study." .

### ================================================================
### PART 1 - ORIGINAL TRANSFER CORE (unchanged)
### ================================================================

### ----------------------------------------------------------------
### Classes
### ----------------------------------------------------------------

:NetTask rdf:type owl:Class ;
    rdfs:comment "A TMLNetTask: a Diplodocus task that performs a network transfer (one network channel end)." .

:WriteChannelCommand rdf:type owl:Class ;
    rdfs:comment "A time-consuming command that writes a quantity of data to a channel destined for the network." .

:DataQuantity rdf:type owl:Class ;
    rdfs:comment "An abstract quantity of data manipulated inside Diplodocus (bytes, not a real buffer)." .

:CycleTimePoint rdf:type owl:Class ;
    rdfs:comment "A point in Diplodocus' abstract logical clock, measured in master-clock cycles." .

### ----------------------------------------------------------------
### Object properties
### ----------------------------------------------------------------

:hasDataQuantity rdf:type owl:ObjectProperty ;
    rdfs:domain :WriteChannelCommand ;
    rdfs:range :DataQuantity ;
    rdfs:comment "Links a WriteChannelCommand to the data quantity it transfers." .

:startsAtCycle rdf:type owl:ObjectProperty ;
    rdfs:domain :WriteChannelCommand ;
    rdfs:range :CycleTimePoint ;
    rdfs:comment "The Diplodocus cycle at which the network transaction begins." .

:endsAtCycle rdf:type owl:ObjectProperty ;
    rdfs:domain :WriteChannelCommand ;
    rdfs:range :CycleTimePoint ;
    rdfs:comment "The Diplodocus cycle at which the network transaction completes. Filled in only after the NS3 result returns." .

### ----------------------------------------------------------------
### Datatype properties (the values that change at runtime)
### ----------------------------------------------------------------

:DataSize rdf:type owl:DatatypeProperty ;
    rdfs:domain :DataQuantity ;
    rdfs:range xsd:integer ;
    rdfs:comment "The size of the data quantity in bytes. Read from the live Diplodocus simulation state, not static." .

:cycleValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :CycleTimePoint ;
    rdfs:range xsd:double ;
    rdfs:comment "The cycle count of a CycleTimePoint, w.r.t. the master clock (whole cycles, stored as xsd:double)." .

:FrequencyHz rdf:type owl:DatatypeProperty ;
    rdfs:domain :NetTask ;
    rdfs:range xsd:double ;
    rdfs:comment "Frequency (Hz) of the node executing this task, used to convert its cycles to/from nanoseconds. In TTool it equals the master clock frequency divided by the node's clock divider; with a divider of 1 (as in the case study) it is the master clock frequency." .

### ================================================================
### PART 2 - CHANNEL SEMANTICS AND MAPPING (new)
###
### Only Diplodocus concepts appear here. Nothing in this ontology
### mentions ns-3: what a channel REQUIRES from a network is stated
### in the mapping ontology.
### ================================================================

### ----------------------------------------------------------------
### Classes
### ----------------------------------------------------------------

:Channel rdf:type owl:Class ;
    rdfs:comment "A TML data channel between two task ports (TMLbrbwChannel, TMLbrnbwChannel, ...). Attributes are those of the port dialog in TTool." .

:ArchitectureElement rdf:type owl:Class ;
    rdfs:comment "Any node of the DIPLODOCUS architecture (TTool deployment diagram): CPU, memory, bus, network interface, network, router." .

:ExecutionNode rdf:type owl:Class ;
    rdfs:subClassOf :ArchitectureElement ;
    rdfs:comment "An architecture node on which TASKS are mapped (CPU, network interface)." .

:CommunicationElement rdf:type owl:Class ;
    rdfs:subClassOf :ArchitectureElement ;
    rdfs:comment "An architecture node a channel can be mapped on (storage or transport): bus, memory, network, router." .

:ExecutionNode owl:disjointWith :CommunicationElement .

:CPU rdf:type owl:Class ;
    rdfs:subClassOf :ExecutionNode ;
    rdfs:comment "A DIPLODOCUS processor executing application tasks." .

:NetworkInterface rdf:type owl:Class ;
    rdfs:subClassOf :ExecutionNode ;
    rdfs:comment "TTool 'Network Interface': execution node hosting the networking tasks (NetTasks) that move data between local channels and a network." .

:CPU owl:disjointWith :NetworkInterface .

:Bus rdf:type owl:Class ;
    rdfs:subClassOf :CommunicationElement ;
    rdfs:comment "A DIPLODOCUS bus (local, memory-mapped communication)." .

:Memory rdf:type owl:Class ;
    rdfs:subClassOf :CommunicationElement ;
    rdfs:comment "A DIPLODOCUS memory storing the samples of the channels mapped on it." .

:Network rdf:type owl:Class ;
    rdfs:subClassOf :CommunicationElement ;
    rdfs:comment "A DIPLODOCUS network element (link between network interfaces / routers)." .

:NetworkRouter rdf:type owl:Class ;
    rdfs:subClassOf :CommunicationElement ;
    rdfs:comment "TTool 'Network Router': relay forwarding packets between the networks it is attached to (the network counterpart of a bus bridge). A channel can also be mapped on it." .

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Bus :Memory :Network :NetworkRouter ) ] .

### Defined classes: membership is COMPUTED by the reasoner from the
### channel attributes and from the mapping; nobody asserts them.

:NetworkChannel rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf ( :Channel
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :mappedOn ;
                               owl:someValuesFrom :Network ] )
    ] ;
    rdfs:comment "A channel mapped on at least one Network element. Decided by the MAPPING, not by the tasks (Y-chart separation)." .

:BackpressureChannel rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf ( :Channel
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isBlocking ;
                               owl:hasValue "true"^^xsd:boolean ] )
    ] ;
    rdfs:comment "Blocking-write channel (TMLbrbwChannel): the writer is suspended when 'capacity' samples are pending." .

:LossyChannel rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf ( :Channel
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isLossy ;
                               owl:hasValue "true"^^xsd:boolean ] )
    ] ;
    rdfs:comment "Channel whose semantics include data loss (lossPercentage): the reader must observe missing samples." .

:LosslessChannel rdf:type owl:Class ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:intersectionOf ( :Channel
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isLossy ;
                               owl:hasValue "false"^^xsd:boolean ] )
    ] ;
    rdfs:comment "Channel whose semantics guarantee delivery of every written sample." .

### ----------------------------------------------------------------
### Object properties
### ----------------------------------------------------------------

:handlesChannel rdf:type owl:ObjectProperty ;
    rdfs:domain :NetTask ;
    rdfs:range :Channel ;
    rdfs:comment "A NetTask (network-interface task) reads or writes this channel." .

:writesChannel rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :handlesChannel ;
    rdfs:domain :NetTask ;
    rdfs:range :Channel ;
    rdfs:comment "The NetTask is the WRITER (origin) of this channel." .

:readsChannel rdf:type owl:ObjectProperty ;
    rdfs:subPropertyOf :handlesChannel ;
    rdfs:domain :NetTask ;
    rdfs:range :Channel ;
    rdfs:comment "The NetTask is the READER (destination) of this channel." .

:writesOn rdf:type owl:ObjectProperty ;
    rdfs:domain :WriteChannelCommand ;
    rdfs:range :Channel ;
    rdfs:comment "The channel a WriteChannelCommand writes to." .

:issuedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :WriteChannelCommand ;
    rdfs:range :NetTask ;
    rdfs:comment "The NetTask that executes this WriteChannelCommand." .

:mappedOn rdf:type owl:ObjectProperty ;
    rdfs:domain :Channel ;
    rdfs:range :CommunicationElement ;
    rdfs:comment "Communication element (bus, memory, network, router) a channel is mapped on (TTool mapping)." .

:executesOn rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :NetTask ;
    rdfs:range :NetworkInterface ;
    rdfs:comment "TTool mapping: the network interface a NetTask is mapped on." .

### ----------------------------------------------------------------
### Datatype properties (read from the TTool port dialog)
### ----------------------------------------------------------------

:channelName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Channel ;
    rdfs:range xsd:string .

:isBlocking rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Channel ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Port dialog 'Blocking?'. true => TMLbrbwChannel (blocking write)." .

:isLossy rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Channel ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Port dialog 'Lossy'." .

:lossPercentage rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Channel ;
    rdfs:range xsd:integer ;
    rdfs:comment "Port dialog 'Loss percentage'." .

:maxNbOfLoss rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Channel ;
    rdfs:range xsd:integer ;
    rdfs:comment "Port dialog 'Max nb of loss' (0 = unbounded)." .

:capacitySamples rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Channel ;
    rdfs:range xsd:integer ;
    rdfs:comment "Port dialog 'Capacity' (samples pending before a blocking writer is suspended)." .

:widthBytes rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Channel ;
    rdfs:range xsd:integer ;
    rdfs:comment "Port dialog 'Width (in Byte)': size of one sample." .

### ================================================================
### PART 2b - NETWORK TOPOLOGY (read from the TTool deployment diagram)
###
### Network interfaces and routers are the nodes of the network path;
### networks are the links between them.
### ================================================================

:attachedTo rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :NetworkInterface :NetworkRouter ) ] ;
    rdfs:range :Network ;
    rdfs:comment "Network a network interface or a router is connected to in the TTool deployment diagram." .

:bandwidthBps rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain [ rdf:type owl:Class ; owl:unionOf ( :NetworkInterface :NetworkRouter :Network ) ] ;
    rdfs:range xsd:long ;
    rdfs:comment "Bandwidth from the TTool node dialog, converted to bit/s (TTool unit: 0 = kb/s, 1 = Mb/s, 2 = Gb/s)." .

:propagationSpeed rdf:type owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Network ;
    rdfs:range xsd:integer ;
    rdfs:comment "TTool 'propagation speed' field of a network, stored as entered (TTool defines no unit for it). Not used to compute the NS-3 delay." .

### ================================================================
### PART 3 - START-UP MODEL CHECK (new)
###
### Diplodocus writes ONE ModelCheckRequest before cycle 0. The Java
### bridge then reads the TTool model, adds the Channel / NetTask /
### Network / Bus / NetworkInterface / NetworkRouter individuals, and asks the reasoner whether the
### network channels can be co-simulated (consistency + TCP/UDP).
### ================================================================

:ModelCheckRequest rdf:type owl:Class ;
    rdfs:comment "Request, written by Diplodocus at start-up, to check the network channels of a TTool model before co-simulation." .

:modelPath rdf:type owl:DatatypeProperty ;
    rdfs:domain :ModelCheckRequest ;
    rdfs:range xsd:string ;
    rdfs:comment "Path of the TTool .xml model to check." .

### ================================================================
### PART 4 - INDIVIDUALS used by the transfer pipeline
### (the channel / NI-task individuals are generated at start-up)
### ================================================================

:EV_ChargingRequest_NetTask rdf:type :NetTask ;
    rdfs:comment "Clock reference used by the cycle <-> ns conversions." ;
    :FrequencyHz "200000000.0"^^xsd:double .
